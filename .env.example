# این فایل را به .env کپی کنید و مقادیر را پر کنید. هر کانالی که خالی بماند، نادیده گرفته می‌شود.

# ── ایمیل (Gmail: از myaccount.google.com/apppasswords یک App Password بسازید) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
# REPORT_EMAIL_FROM=
# اگر روزی فرصت مناسبی نبود هم ایمیل بیاید؟
REPORT_SEND_EMPTY=true

# ── تلگرام (اختیاری): توکن از @BotFather، شناسه‌ی چت از @userinfobot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheet (اختیاری) ──
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=config/google-service-account.json
# یا محتوای کامل JSON در یک خط:
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_TAB=Opportunities
# حداقل امتیاز برای رفتن به شیت (خالی = همان min_score پروفایل)
SHEET_MIN_SCORE=

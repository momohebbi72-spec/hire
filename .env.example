# این فایل را به .env کپی کنید (start.command خودکار این کار را می‌کند). هر بخشی خالی بماند، نادیده گرفته می‌شود.
# روی GitHub همین مقادیر را در Settings → Secrets and variables → Actions بگذارید.

# ── ایمیل (Gmail: myaccount.google.com/apppasswords) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=

# ── همگام‌سازی مک ⇄ GitHub (فقط روی مک لازم است) ──
# Fine-grained token با دسترسی Contents: Read and write فقط روی همین ریپو
GITHUB_TOKEN=
GITHUB_REPO=momohebbi72-spec/hire

# ── Google Sheet از طریق Apps Script (بدون Google Cloud) ──
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=
GOOGLE_SHEET_URL=
# یا Service Account (نیاز به Google Cloud Console):
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=config/google-service-account.json
# SHEET_MIN_SCORE=

# ── جستجوی گوگل (اختیاری؛ بدون کلید از DuckDuckGo استفاده می‌شود) ──
# serper.dev → 2500 جستجوی رایگان
SERPER_API_KEY=
# یا serpapi.com → 100 جستجوی رایگان در ماه
SERPAPI_API_KEY=

# ── تلگرام (اختیاری): توکن از @BotFather، Chat ID از @userinfobot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI (اختیاری، برای آینده): rules | openai | claude | gemini | local ──
AI_PROVIDER=rules

# این فایل را به geo_cards/.env کپی کن (یا همین کلیدها را در .env ریشه‌ی پروژه بگذار).

# ── OpenAI: موتور اصلی سری «سؤال روز» ──
OPENAI_API_KEY=
# اگر از درگاه ایرانی سازگار با OpenAI استفاده می‌کنی، آدرس API آن را اینجا بگذار
OPENAI_BASE_URL=

# ── اختیاری ──
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# اگر کروم در مسیر معمول نیست
CHROME_PATH=
# اگر ffmpeg در مسیر معمول نیست
FFMPEG_PATH=
# پوشه‌ی خروجی (پیش‌فرض: geo_cards/output)
GEO_CARDS_OUTPUT=
